                                                        :LivingRoomSpace1Temperature;
                                                <http://www.semanticweb.org/ivans/ontologies/2025/instance-model-1#withPropertyChangeCheck>
                                                        <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/ValueIncrease>;
                                                <http://www.semanticweb.org/ivans/ontologies/2025/instance-model-1#withPropertyCheck>
                                                        :LivingRoomSpace1Temperature , :HVACHeatingSetpoint;
                                                owl:hasValue    :HVACHeatingSetpoint;
                                                owl:onProperty  <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/greaterThanOrEqualTo>
                                              ];
                    owl:onProperty            <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/hasConstraint>;
                    owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                  ];
        <http://www.semanticweb.org/ivans/ontologies/2025/instance-model-1#isEnabled>
                true;
        <http://www.w3.org/ns/ssn/forProperty>
                :LivingRoomSpace1Temperature .

