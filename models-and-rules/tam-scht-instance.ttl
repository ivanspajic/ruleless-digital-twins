                                                      owl:imports <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins>.
:CoolingOptimalCondition a owl:NamedIndividual,
                           <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/OptimalCondition>,
                           [a owl:Restriction ; 
                            owl:onProperty <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/hasConstraint> ; 
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                            owl:onClass [a owl:Restriction ; 
                                         owl:onProperty <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/lessThanOrEqualTo> ; 
                                         owl:hasValue :HVACCoolingSetpoint]].
:HVAC <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/enacts> :HouseTempDecrease,
                                                                                       :HouseTempIncrease;
      <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/hasActuatorState> "0"^^xsd:int,
                                                                                                 "1"^^xsd:int;
      a owl:NamedIndividual,
        <http://www.w3.org/ns/sosa/Actuator>.
:HVACCoolingSetpoint <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/hasValue> "24.0"^^xsd:double;
                     a owl:NamedIndividual,
                       <http://www.w3.org/ns/ssn/Property>.
:HVACHeatingSetpoint <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/hasValue> "20.0"^^xsd:double;
                     a owl:NamedIndividual,
                       <http://www.w3.org/ns/ssn/Property>.
:HeatingOptimalCondition a owl:NamedIndividual,
                           <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/OptimalCondition>,
                           [a owl:Restriction ; 
                            owl:onProperty <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/hasConstraint> ; 
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                            owl:onClass [a owl:Restriction ; 
                                         owl:onProperty <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/greaterThanOrEqualTo> ; 
                                         owl:hasValue :HVACHeatingSetpoint]].
