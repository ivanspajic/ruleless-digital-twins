:HVAC_0  rdf:type  <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/ActuationAction>;
        <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/hasActuator>
                :HVAC;
        <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/hasActuatorState>
                "0"^^xsd:int .

[ rdf:type  <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/ActionCombination>;
  <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/hasActions>
          [ rdf:type   rdf:List;
            rdf:first  :HVAC_1;
            rdf:rest   ()
          ];
  <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/hasActuators>
          [ rdf:type   rdf:List;
            rdf:first  :HVAC;
            rdf:rest   ()
          ]
] .

[ rdf:type  <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/ActionCombination>;
  <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/hasActions>
          [ rdf:type   rdf:List;
            rdf:first  :HVAC_0;
            rdf:rest   ()
          ];
  <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/hasActuators>
          [ rdf:type   rdf:List;
            rdf:first  :HVAC;
            rdf:rest   ()
          ]
] .

:CoolingOptimalCondition
        rdf:type  <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/OptimalCondition> , owl:NamedIndividual;
        rdf:type  [ rdf:type                  owl:Restriction;
                    owl:onClass               [ rdf:type        owl:Restriction;
                                                owl:hasValue    :HVACCoolingSetpoint;
                                                owl:onProperty  <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/lessThanOrEqualTo>
                                              ];
                    owl:onProperty            <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/hasConstraint>;
                    owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                  ];
        <http://www.semanticweb.org/ivans/ontologies/2025/instance-model-1#isEnabled>
                true .

:HeatingOptimalCondition
        rdf:type  <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/OptimalCondition> , owl:NamedIndividual;
        rdf:type  [ rdf:type                  owl:Restriction;
                    owl:onClass               [ rdf:type        owl:Restriction;
                                                owl:hasValue    :HVACHeatingSetpoint;
                                                owl:onProperty  <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/greaterThanOrEqualTo>
                                              ];
                    owl:onProperty            <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/hasConstraint>;
                    owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                  ];
        <http://www.semanticweb.org/ivans/ontologies/2025/instance-model-1#isEnabled>
                true .

:HVAC_1  rdf:type  <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/ActuationAction>;
        <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/hasActuator>
                :HVAC;
        <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/hasActuatorState>
                "1"^^xsd:int .

