:RoomTemperatureIncrease
        rdf:type                 owl:NamedIndividual , rdt:PropertyChange;
        rdt:affectsPropertyWith  rdt:ValueIncrease;
        <http://www.w3.org/ns/ssn/forProperty>
                :RoomTemperature .

:OfficeTemperatureLowerLimit
        rdf:type      owl:NamedIndividual , <http://www.w3.org/ns/ssn/Property>;
        rdt:hasValue  "18.0"^^xsd:double .

:EnergyConsumptionAccumulator
        rdf:type  owl:NamedIndividual , <http://www.w3.org/ns/sosa/Sensor>;
        <http://www.w3.org/ns/ssn/implements>
                :EnergyConsumptionAccumulatorProcedure .

:RoomTemperature  rdf:type  owl:NamedIndividual , <http://www.w3.org/ns/sosa/ObservableProperty>;
        rdt:hasValue  "19.89676028563136"^^xsd:double .

:PricePerEnergyAccumulatorProcedure
        rdf:type  owl:NamedIndividual , <http://www.w3.org/ns/sosa/Procedure>;
        <http://www.w3.org/ns/ssn/hasInput>
                :PricePerEnergy;
        <http://www.w3.org/ns/ssn/hasOutput>
                :PricePerEnergyAccumulated .

:EnergyConsumptionAccumulated
        rdf:type      owl:NamedIndividual , <http://www.w3.org/ns/ssn/Property>;
        rdt:hasValue  "0.0"^^xsd:double .

:PricePerEnergyProcedure
        rdf:type  owl:NamedIndividual , <http://www.w3.org/ns/sosa/Procedure>;
        <http://www.w3.org/ns/ssn/hasInput>
                :EnergyConsumptionMeterMeasuredEnergyConsumption , :Price;
        <http://www.w3.org/ns/ssn/hasOutput>
                :PricePerEnergy .

:HumiditySensorMeasuredRoomHumidity
        rdf:type      owl:NamedIndividual , <http://www.w3.org/ns/ssn/Output> , <http://www.w3.org/ns/ssn/Property>;
        rdt:hasValue  "49.96102205102658"^^xsd:double .

:EnergyConsumptionMeterProcedure
        rdf:type  owl:NamedIndividual , <http://www.w3.org/ns/sosa/Procedure>;
        <http://www.w3.org/ns/ssn/hasOutput>
                :EnergyConsumptionMeterMeasuredEnergyConsumption .

:EnergyConsumption  rdf:type  owl:NamedIndividual , <http://www.w3.org/ns/sosa/ObservableProperty>;
        rdt:hasValue  "20.15986275"^^xsd:double .

rdt:PropertyChangeByActuation
        rdf:type  owl:Class .

:OfficeTemperatureOptimalCondition
        rdf:type                 owl:NamedIndividual , rdt:OptimalCondition;
        rdf:type                 [ rdf:type                  owl:Restriction;
                                   owl:onClass               [ rdf:type            owl:Class;
                                                               owl:intersectionOf  ( [ rdf:type        owl:Restriction;
                                                                                       owl:hasValue    :OfficeTemperatureLowerLimit;
                                                                                       owl:onProperty  rdt:greaterThan
                                                                                     ]
                                                                                     [ rdf:type        owl:Restriction;
                                                                                       owl:hasValue    :OfficeTemperatureUpperLimit;
                                                                                       owl:onProperty  rdt:lessThanOrEqualTo
                                                                                     ]
                                                                                   )
                                                             ];
                                   owl:onProperty            rdt:hasConstraint;
                                   owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                                 ];
        rdf:type                 [ rdf:type                  owl:Restriction;
                                   owl:onClass               [ rdf:type        owl:Restriction;
                                                               owl:hasValue    :MotionActivated;
                                                               owl:onProperty  rdt:equalTo
                                                             ];
                                   owl:onProperty            rdt:hasEnablingConstraint;
                                   owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                                 ];
        rdt:forEnablingProperty  :Motion;
        rdt:isBreakable          true;
        <http://www.w3.org/ns/ssn/forProperty>
                :RoomTemperature .

:MotionSensorProcedure
        rdf:type  owl:NamedIndividual , <http://www.w3.org/ns/sosa/Procedure>;
        <http://www.w3.org/ns/ssn/hasOutput>
                :MotionSensorMeasuredMotion .

:PricePerEnergy  rdf:type  owl:NamedIndividual , <http://www.w3.org/ns/ssn/Output> , <http://www.w3.org/ns/ssn/Property>;
        rdt:hasValue  "30.441392752499997"^^xsd:double .

:EnergyConsumptionDecrease
        rdf:type                 owl:NamedIndividual , rdt:PropertyChange;
        rdt:affectsPropertyWith  rdt:ValueDecrease;
        <http://www.w3.org/ns/ssn/forProperty>
                :EnergyConsumption .

:Heater  rdf:type             owl:NamedIndividual , <http://www.w3.org/ns/sosa/Actuator>;
        rdt:enacts            :EnergyConsumptionIncrease , :RoomTemperatureIncrease;
        rdt:hasActuatorState  "0"^^xsd:int , "1"^^xsd:int , "2"^^xsd:int .

:OfficeHumidityLowerLimit
        rdf:type      owl:NamedIndividual , <http://www.w3.org/ns/ssn/Property>;
        rdt:hasValue  "30.0"^^xsd:double .

:TemperatureSensor1  rdf:type  owl:NamedIndividual , <http://www.w3.org/ns/sosa/Sensor>;
        <http://www.w3.org/ns/sosa/observes>
                :RoomTemperature;
        <http://www.w3.org/ns/ssn/implements>
                :TemperatureSensor1Procedure .

:Motion  rdf:type     owl:NamedIndividual , <http://www.w3.org/ns/sosa/ObservableProperty>;
        rdt:hasValue  true .

:FakepoolProcedure  rdf:type  owl:NamedIndividual , <http://www.w3.org/ns/sosa/Procedure>;
        <http://www.w3.org/ns/ssn/hasInput>
                :MapekCycle;
        <http://www.w3.org/ns/ssn/hasOutput>
                :Price .

:MapekCycle  rdf:type  owl:NamedIndividual , <http://www.w3.org/ns/ssn/Property>;
        rdt:hasValue  "0"^^xsd:int .

:EnergyConsumptionMeter
        rdf:type  owl:NamedIndividual , <http://www.w3.org/ns/sosa/Sensor>;
        <http://www.w3.org/ns/sosa/observes>
                :EnergyConsumption;
        <http://www.w3.org/ns/ssn/implements>
                :EnergyConsumptionMeterProcedure .

:TemperatureSensor1Procedure
        rdf:type  owl:NamedIndividual , <http://www.w3.org/ns/sosa/Procedure>;
        <http://www.w3.org/ns/ssn/hasOutput>
                :TemperatureSensor1MeasuredRoomTemperature .

<http://www.semanticweb.org/ivans/ontologies/2025/instance-model-1>
        rdf:type     owl:Ontology;
        owl:imports  <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins> .

:PricePerEnergySensor
        rdf:type  owl:NamedIndividual , <http://www.w3.org/ns/sosa/Sensor>;
        <http://www.w3.org/ns/ssn/implements>
