        rdf:type      <http://www.w3.org/ns/ssn/Property> , <http://www.w3.org/ns/ssn/Output> , owl:NamedIndividual;
        rdt:hasValue  "54.510521499999996"^^xsd:double .

:TemperatureSensor2  rdf:type  <http://www.w3.org/ns/sosa/Sensor> , owl:NamedIndividual;
        <http://www.w3.org/ns/sosa/observes>
                :RoomTemperature;
        <http://www.w3.org/ns/ssn/implements>
                :TemperatureSensor2Procedure .

:Price  rdf:type      <http://www.w3.org/ns/ssn/Property> , <http://www.w3.org/ns/ssn/Output> , owl:NamedIndividual;
        rdt:hasValue  "1.479"^^xsd:double .

:Fakepool  rdf:type  <http://www.w3.org/ns/sosa/Sensor> , owl:NamedIndividual;
        <http://www.w3.org/ns/ssn/implements>
                :FakepoolProcedure .

