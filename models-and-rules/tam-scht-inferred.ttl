[ rdf:type  <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/ActionCombination>;
  <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/hasActions>
          [ rdf:type   rdf:List;
            rdf:first  :HVAC_0;
            rdf:rest   ()
          ];
  <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/hasActuators>
          [ rdf:type   rdf:List;
            rdf:first  :HVAC;
            rdf:rest   ()
          ]
] .

[ rdf:type  <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/ActionCombination>;
