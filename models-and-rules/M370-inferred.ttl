                                                                        [ rdf:type        owl:Restriction;
                                                                          owl:hasValue    :TestLimit2;
                                                                          owl:onProperty  rdt:greaterThan
                                                                        ]
                                                                      )
                                                ];
                      owl:onProperty            rdt:hasConstraint;
                      owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
